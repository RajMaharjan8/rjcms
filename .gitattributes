# Keep development-only files out of `composer require` installs (dist tarballs).
/tests              export-ignore
/node_modules       export-ignore
/.github            export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
DEVELOPMENT.md      export-ignore
phpunit.xml         export-ignore
package.json        export-ignore
package-lock.json   export-ignore
/resources/css      export-ignore
/resources/js       export-ignore
# NOTE: resources/dist (pre-built assets) is intentionally NOT ignored — it ships.
